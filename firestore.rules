rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    function isValidReview(data) {
      return data.movieId is string &&
             data.userId is string &&
             data.userName is string &&
             data.content is string &&
             data.content.size() > 0 &&
             data.content.size() < 5000 &&
             data.rating is number &&
             data.rating >= 1 &&
             data.rating <= 10;
    }
    
    function isValidReply(data) {
      return data.userId is string &&
             data.userName is string &&
             data.content is string &&
             data.content.size() > 0 &&
             data.content.size() < 2000;
    }

    function isValidQuizScore(data) {
      return data.userId is string &&
             data.userName is string &&
             data.score is number &&
             data.totalQuestions is number &&
             data.createdAt is string;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserListEntry(data, userId, wikidataId) {
      return data.keys().hasAll(['userid', 'wikidataid', 'isfavorite', 'iswatched', 'watchlater', 'lastupdated']) &&
             data.keys().hasOnly(['userid', 'wikidataid', 'isfavorite', 'iswatched', 'watchlater', 'lastupdated']) &&
             data.userid is string &&
             data.userid.size() <= 128 &&
             data.userid == userId &&
             data.userid == request.auth.uid &&
             data.wikidataid is string &&
             data.wikidataid == wikidataId &&
             isValidId(data.wikidataid) &&
             data.isfavorite is bool &&
             data.iswatched is bool &&
             data.watchlater is bool &&
             data.lastupdated is timestamp &&
             data.lastupdated == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId}/userlists/{wikidataId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(wikidataId);
      allow list: if isOwner(userId) && isValidId(userId) && resource.data.userid == request.auth.uid;
      allow create: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(wikidataId) &&
                      request.auth.token.email_verified == true &&
                      isValidUserListEntry(request.resource.data, userId, wikidataId);
      allow update: if isOwner(userId) &&
                      isValidId(userId) &&
                      isValidId(wikidataId) &&
                      request.auth.token.email_verified == true &&
                      isValidUserListEntry(request.resource.data, userId, wikidataId) &&
                      request.resource.data.userid == resource.data.userid &&
                      request.resource.data.wikidataid == resource.data.wikidataid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isfavorite', 'iswatched', 'watchlater', 'lastupdated']);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(wikidataId);
    }

    match /quiz_scores/{scoreId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidQuizScore(request.resource.data);
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidReview(request.resource.data);
      allow update, delete: if isDocOwner();
      
      match /replies/{replyId} {
        allow read: if true; // Publicly readable
        allow create: if isAuthenticated() && 
                        request.resource.data.userId == request.auth.uid &&
                        isValidReply(request.resource.data);
        allow update, delete: if isDocOwner();
      }
    }
  }
}
